# A root module that needs no provider download and no credentials:
# terraform_data comes from terraform's built-in provider, and the
# backend is local. Stored as main.tf.fixture so this repository's own
# `standards check .` does not detect it as a terraform target; the
# -tags ops tests copy it to main.tf in a temporary repository.
terraform {
  required_version = ">= 1.5.0"

  backend "local" {
    path = "terraform.tfstate"
  }
}

variable "greeting" {
  type = string
}

resource "terraform_data" "marker" {
  input = var.greeting
}
