{
  "schema_version": 1,
  "id": "acme.billing.api",
  "version": "1.0.0",
  "sections": [
    { "id": "go.errors", "path": "languages/go/guidance/04-errors.md", "severity": "must",
      "applies_to": { "languages": ["go"], "stages": ["implement", "review"] } },
    { "id": "process.adr", "path": "process/guidance/adr.md", "severity": "must", "applies_to": { "stages": ["plan"] } }
  ],
  "checks": [
    { "id": "commit.conventional", "kind": "commit", "severity": "must", "applies_to": { "stages": ["ship"] } },
    { "id": "go.lint", "kind": "lint", "tool": "golangci-lint", "config": "languages/go/checks/golangci.yml", "severity": "must",
      "applies_to": { "languages": ["go"] } }
  ],
  "overrides": [
    { "id": "go.errors", "reason": "this service wraps every error with the platform's own trace-carrying type" }
  ]
}
