{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-flow.dev/schema/dryrun-results.schema.json",
  "title": "dryrun-results",
  "description": "~/.ai-flow/<KEY>/dryrun-results.json",
  "type": "object",
  "required": ["mode", "targets"],
  "additionalProperties": false,
  "properties": {
    "mode": { "enum": ["live", "offline"] },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hash", "target", "validation"],
        "additionalProperties": false,
        "properties": {
          "hash": { "type": "string" },
          "target": { "type": "string" },
          "validation": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["message", "severity", "tool"],
              "additionalProperties": false,
              "properties": {
                "file": { "type": "string" },
                "line": { "type": "integer" },
                "message": { "type": "string" },
                "severity": { "type": "string" },
                "tool": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
