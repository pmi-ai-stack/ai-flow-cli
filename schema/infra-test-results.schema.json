{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-flow.dev/schema/infra-test-results.schema.json",
  "title": "infra-test-results",
  "description": "~/.ai-flow/<KEY>/infra-test-results.json — one entry per (target, harness) actually run against the branch rendering; a --ref base diagnostic run is never written here (phase 24's own design decision 10).",
  "type": "object",
  "required": ["targets"],
  "additionalProperties": false,
  "properties": {
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "harness", "kind", "tool", "total", "passed", "failed", "skipped", "failures", "report"],
        "additionalProperties": false,
        "properties": {
          "target": { "type": "string", "description": "TargetKey: <repo>:<path>" },
          "harness": { "type": "string", "description": "the harness file's own repo-root-relative path" },
          "kind": { "type": "string", "enum": ["unit", "e2e"] },
          "tool": { "type": "string", "enum": ["terraform-test", "terratest", "kuttl", "chainsaw"] },
          "total": { "type": "integer", "minimum": 0 },
          "passed": { "type": "integer", "minimum": 0 },
          "failed": { "type": "integer", "minimum": 0 },
          "skipped": { "type": "integer", "minimum": 0 },
          "failures": { "type": "array", "items": { "type": "string" } },
          "report": { "type": "string", "description": "path under infra-test-reports/ this entry's raw tool output was written to" }
        }
      }
    }
  }
}
