{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-flow.dev/schema/pack.schema.json",
  "title": "pack",
  "description": "<pack-dir>/standards.json — a standards pack's own manifest: sections (guidance) and checks (tool runs) a pack contributes at the org, team or repo layer. Not a ticket handoff artifact; registered alongside the sixteen that are so `ai-flow schema pack` and internal/schema stay the one canonical listing of every JSON shape in the system. internal/standards.Validate layers cross-referencing rules (check_runner_missing, path existence) on top of this schema's shape check.",
  "type": "object",
  "required": ["schema_version", "id", "version", "sections", "checks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "appliesTo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "languages": { "type": "array", "items": { "type": "string" } },
        "addons": { "type": "array", "items": { "type": "string" } },
        "stages": { "type": "array", "items": { "type": "string" } }
      }
    },
    "section": {
      "type": "object",
      "required": ["id", "path", "severity"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["must", "should", "may"] },
        "applies_to": { "$ref": "#/$defs/appliesTo" }
      }
    },
    "check": {
      "type": "object",
      "required": ["id", "kind", "tool", "severity"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["format", "lint", "policy", "scan", "dependency", "secrets", "layout", "docs", "commit", "pr"] },
        "tool": { "type": "string", "minLength": 1 },
        "config": { "type": "string" },
        "severity": { "enum": ["must", "should", "may"] },
        "input": { "enum": ["source", "render"], "default": "source" },
        "applies_to": { "$ref": "#/$defs/appliesTo" }
      }
    }
  }
}
