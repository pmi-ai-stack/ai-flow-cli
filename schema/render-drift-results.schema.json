{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-flow.dev/schema/render-drift-results.schema.json",
  "title": "render-drift-results",
  "description": "~/.ai-flow/<KEY>/render-drift-results.json",
  "type": "object",
  "required": ["targets"],
  "additionalProperties": false,
  "properties": {
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["drift", "drift_resources", "hash", "target", "validation"],
        "additionalProperties": false,
        "properties": {
          "drift": { "enum": ["none", "present", "not_applicable", "offline"] },
          "drift_resources": { "type": "array", "items": { "type": "string" } },
          "hash": { "type": "string" },
          "target": { "type": "string" },
          "validation": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["message", "severity", "tool"],
              "additionalProperties": false,
              "properties": {
                "file": { "type": "string" },
                "line": { "type": "integer" },
                "message": { "type": "string" },
                "severity": { "type": "string" },
                "tool": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
